<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:textSize="@dimen/downloads_list_status_message_font_size" android:id="@+id/downloadStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="5dp"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <ListView android:id="@+id/downloadQueue" android:layout_width="match_parent" android:layout_height="match_parent" android:keepScreenOn="true"/>
        <TextView android:id="@android:id/empty" android:text="@string/noDownloadsInQueue" style="@style/EmptyListText"/>
    </FrameLayout>
</LinearLayout>
