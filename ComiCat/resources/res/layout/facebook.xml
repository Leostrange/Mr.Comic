<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:padding="5dp" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/authorizationView" android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:gravity="center_horizontal" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/whyAuthorize"/>
        <Button android:id="@+id/authorize" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/authorizeComiCat"/>
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:id="@+id/settingsView" android:layout_width="match_parent" android:layout_height="match_parent">
        <ListView android:id="@+id/categories" android:layout_width="match_parent" android:layout_height="match_parent" android:isScrollContainer="false"/>
    </LinearLayout>
</LinearLayout>
