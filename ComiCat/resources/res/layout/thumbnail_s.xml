<?xml version="1.0" encoding="utf-8"?>
<meanlabs.comicreader.ui.ThumbnailItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="@dimen/thumb_column_height">
    <ImageView android:id="@+id/thumbImage" android:paddingLeft="@dimen/thumb_horizontal_padding" android:paddingTop="4dp" android:paddingRight="@dimen/thumb_horizontal_padding" android:paddingBottom="4dp" android:layout_width="wrap_content" android:layout_height="@dimen/thumb_height_comic" android:scaleType="fitCenter" android:adjustViewBounds="true" android:layout_centerHorizontal="true" style="@style/ThumbnailImage"/>
    <ImageView android:id="@+id/thumbFront" android:paddingBottom="4dp" android:layout_width="@dimen/thumb_tray_width_folder" android:layout_height="@dimen/thumb_tray_height_folder" android:layout_marginLeft="5dp" android:layout_marginRight="5dp" android:scaleType="fitXY" android:adjustViewBounds="true" android:layout_alignBottom="@+id/thumbImage" android:layout_centerHorizontal="true"/>
    <ImageView android:id="@+id/comicCloudStatusIcon" android:visibility="invisible" android:layout_width="@dimen/cloud_status_icon_size" android:layout_height="@dimen/cloud_status_icon_size" android:layout_alignLeft="@+id/thumbImage" android:layout_alignBottom="@+id/thumbImage"/>
    <ImageView android:id="@+id/folderCloudStatusIcon" android:visibility="invisible" android:layout_width="@dimen/cloud_status_icon_size_folder" android:layout_height="@dimen/cloud_status_icon_size_folder" android:layout_marginLeft="7dp" android:layout_alignLeft="@+id/thumbFront" android:layout_alignBottom="@+id/thumbImage"/>
    <ImageView android:id="@+id/bookmarkIcon" android:visibility="invisible" android:layout_width="@dimen/bookmark_icon_width" android:layout_height="@dimen/bookmark_icon_height" android:layout_marginRight="35dp" android:src="@drawable/bookmark" android:scaleType="fitXY" android:layout_alignTop="@+id/thumbImage" android:layout_alignRight="@+id/thumbImage"/>
    <ImageView android:id="@+id/statusIcon" android:visibility="invisible" android:layout_width="@dimen/status_icon_size" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:layout_centerInParent="true"/>
    <TextView android:id="@+id/itemCount" android:layout_alignBottom="@+id/thumbImage" android:layout_centerHorizontal="true" style="@style/ItemCount"/>
    <TextView android:id="@+id/thumbTitle" android:paddingTop="3dp" android:layout_below="@+id/thumbImage" android:layout_centerHorizontal="true" style="@style/ThumbnailTitle"/>
</meanlabs.comicreader.ui.ThumbnailItemView>
