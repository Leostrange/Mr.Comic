+            title = text.mascotTitle,
+            hint = mrComicMascotMoodHeadline(
+                language = language,
+                mood = mascotState.mood,
+                recentTitle = recentTitle
+            ),
+            showMascot = true
+        )
+    } else {
+        ContinueCompanionPresentation(
+            title = text.progressTitle,
+            hint = text.progressNeutralHint,
+            showMascot = false
+        )
+    }
 }
 
