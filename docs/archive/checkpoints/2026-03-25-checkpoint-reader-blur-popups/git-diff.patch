+internal const val READER_TOOLBAR_MIN_OPACITY = 0.52f
+internal const val READER_TOOLBAR_DEFAULT_BLUR = 0.18f
 
 internal fun readerPanelSurfaceColor(
     base: Color,
     emphasis: Float = 1f,
-    minAlpha: Float = 0.34f
+    minAlpha: Float = READER_TOOLBAR_MIN_OPACITY
 ): Color {
     val themedAlpha = base.alpha.coerceIn(0f, 1f)
     val targetAlpha = if (themedAlpha < 0.999f) themedAlpha * emphasis else emphasis
     return base.copy(alpha = targetAlpha.coerceIn(minAlpha, 1f))
 }
+
+internal fun readerPanelContentColor(surface: Color): Color {
+    val opaqueSurface = surface.copy(alpha = 1f)
+    val lightCandidate = Color(0xFFF6F2EA)
+    val darkCandidate = Color(0xFF171717)
+    val lightContrast = ColorUtils.calculateContrast(lightCandidate.toArgb(), opaqueSurface.toArgb())
+    val darkContrast = ColorUtils.calculateContrast(darkCandidate.toArgb(), opaqueSurface.toArgb())
+    return if (lightContrast >= darkContrast) lightCandidate else darkCandidate
+}
+
+internal fun readerPanelMutedContentColor(surface: Color): Color {
+    val primary = readerPanelContentColor(surface)
+    val alpha = if (surface.copy(alpha = 1f).luminance() < 0.45f) 0.82f else 0.76f
+    return primary.copy(alpha = alpha)
+}
+
+internal fun readerPanelBlurRadius(blurAmount: Float) =
+    ((blurAmount.coerceIn(0f, 1f) * 14f) + 4f).dp
+
+internal fun readerPanelBackdropColor(surface: Color, blurAmount: Float): Color {
+    val boostedAlpha = surface.alpha.coerceAtLeast(READER_TOOLBAR_MIN_OPACITY) +
+        blurAmount.coerceIn(0f, 1f) * 0.08f
+    return surface.copy(alpha = boostedAlpha.coerceIn(READER_TOOLBAR_MIN_OPACITY, 0.94f))
+}
+
+@Composable
+internal fun ReaderPanelBackdrop(
+    modifier: Modifier = Modifier,
+    surfaceColor: Color,
+    blurAmount: Float,
+    shape: Shape = RectangleShape
+) {
+    val effectiveBlur = blurAmount.coerceIn(0f, 1f)
+    Box(modifier = modifier.clip(shape)) {
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .background(readerPanelBackdropColor(surfaceColor, effectiveBlur))
+                .then(
+                    if (effectiveBlur > 0.01f) {
+                        Modifier.blur(readerPanelBlurRadius(effectiveBlur))
+                    } else {
+                        Modifier
+                    }
+                )
+        )
+    }
+}
+
+@Composable
+internal fun ReaderBlurredPanelContainer(
+    modifier: Modifier = Modifier,
+    surfaceColor: Color,
+    blurAmount: Float = READER_TOOLBAR_DEFAULT_BLUR,
+    shape: Shape = RectangleShape,
+    shadowElevation: Dp = 0.dp,
+    content: @Composable () -> Unit
+) {
+    Box(
+        modifier = modifier
+            .shadow(elevation = shadowElevation, shape = shape, clip = false)
+            .clip(shape)
+    ) {
+        ReaderPanelBackdrop(
+            modifier = Modifier.fillMaxSize(),
+            surfaceColor = surfaceColor,
+            blurAmount = blurAmount,
+            shape = shape
+        )
+        content()
+    }
+}
