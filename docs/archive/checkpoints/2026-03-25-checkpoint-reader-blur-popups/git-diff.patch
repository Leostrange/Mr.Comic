+        item {
+            FlowRow(
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+                verticalArrangement = Arrangement.spacedBy(8.dp)
+            ) {
+                listOf(
+                    "NONE" to strings.animNone,
+                    "SLIDE" to strings.animSlide,
+                    "FADE" to strings.animFade
+                ).forEach { (value, label) ->
+                    FilterChip(
