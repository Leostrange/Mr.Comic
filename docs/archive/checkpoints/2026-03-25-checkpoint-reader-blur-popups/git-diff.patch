+internal fun renderQualityForScale(scale: Float): Int = when {
+    scale >= 3.2f -> 3
+    scale >= 1.65f -> 2
+    else -> 1
+}
+
+internal fun bestAvailableBitmap(
+    baseBitmap: android.graphics.Bitmap?,
+    quality2Bitmap: android.graphics.Bitmap?,
+    quality3Bitmap: android.graphics.Bitmap?,
+    requestedTier: Int
+): android.graphics.Bitmap? = when {
+    requestedTier >= 3 -> quality3Bitmap ?: quality2Bitmap ?: baseBitmap
+    requestedTier >= 2 -> quality2Bitmap ?: quality3Bitmap ?: baseBitmap
+    else -> baseBitmap ?: quality2Bitmap ?: quality3Bitmap
+}
+
+@Composable
+internal fun rememberOptionalPageBitmap(
+    viewModel: ReaderViewModel,
+    pageIndex: Int,
+    renderQuality: Int,
+    enabled: Boolean
+): State<android.graphics.Bitmap?> {
+    return if (enabled && pageIndex >= 0) {
+        viewModel.getPageFlow(pageIndex, renderQuality)
+            .collectAsState(initial = viewModel.getPage(pageIndex, renderQuality))
+    } else {
+        remember { mutableStateOf(null) }
+    }
+}
