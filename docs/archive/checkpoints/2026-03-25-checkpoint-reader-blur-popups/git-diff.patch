+@OptIn(ExperimentalLayoutApi::class, ExperimentalMaterial3Api::class)
+@Composable
+private fun ReaderServicesTabContent(
+    modifier: Modifier,
+    uiState: ReaderUiState,
+    ttsState: ReaderTtsRuntimeState,
+    isTextReader: Boolean,
+    onTtsPlayPause: () -> Unit,
+    onTtsStop: () -> Unit,
+    onTtsNext: () -> Unit,
+    onTtsPrevious: () -> Unit,
+    onTtsVoiceChange: (String?) -> Unit,
+    onTtsSpeedChange: (Float) -> Unit,
+    onTtsPitchChange: (Float) -> Unit,
+    onTtsVolumeChange: (Float) -> Unit,
+    onTtsSleepTimerChange: (String) -> Unit,
+    onOpenToc: () -> Unit,
+    onToggleBookmark: () -> Unit,
+    onRequestOcr: () -> Unit
+) {
+    val strings = LocalStrings.current
+    val readerText = readerUiText(strings.languageCode)
+    var showVoicePicker by rememberSaveable { mutableStateOf(false) }
+    LazyColumn(
+        modifier = modifier.padding(top = 12.dp),
+        contentPadding = PaddingValues(bottom = 20.dp),
+        verticalArrangement = Arrangement.spacedBy(14.dp)
+    ) {
+        item {
+            Text(
+                text = readerText.servicesQuickActionsTitle,
+                style = MaterialTheme.typography.labelMedium,
+                color = MaterialTheme.colorScheme.onSurfaceVariant
+            )
+        }
+        item {
+            FlowRow(
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+                verticalArrangement = Arrangement.spacedBy(8.dp)
+            ) {
+                if (uiState.tableOfContents.isNotEmpty() || uiState.bookmarkedPages.isNotEmpty()) {
+                    FilledTonalButton(onClick = onOpenToc) {
+                        Text(strings.readerToc)
+                    }
+                }
+                FilledTonalButton(onClick = onToggleBookmark) {
+                    Text(
+                        if (uiState.currentPage in uiState.bookmarkedPages) strings.readerBookmarked
+                        else strings.readerBookmark
+                    )
+                }
+                if (!isTextReader) {
+                    FilledTonalButton(onClick = onRequestOcr) {
+                        Text(readerText.ocrTranslation)
+                    }
+                }
+            }
+        }
+        item {
+            val infoSurface = readerPanelSurfaceColor(
+                base = MaterialTheme.colorScheme.surfaceVariant,
+                emphasis = 0.86f,
+                minAlpha = READER_TOOLBAR_MIN_OPACITY
+            )
+            val infoContentColor = readerPanelContentColor(infoSurface)
+            val infoMutedColor = readerPanelMutedContentColor(infoSurface)
+            ReaderBlurredPanelContainer(
+                shape = RoundedCornerShape(20.dp),
+                surfaceColor = infoSurface,
+                blurAmount = uiState.toolbarBlur
+            ) {
+                Column(
+                    modifier = Modifier.padding(16.dp),
+                    verticalArrangement = Arrangement.spacedBy(8.dp)
+                ) {
+                    Text(
+                        text = readerText.servicesSelectionTitle,
+                        style = MaterialTheme.typography.titleSmall,
+                        fontWeight = FontWeight.SemiBold,
+                        color = infoContentColor
+                    )
+                    Text(
+                        text = if (isTextReader) readerText.servicesSelectionBody else readerText.servicesOcrBody,
+                        style = MaterialTheme.typography.bodyMedium,
+                        color = infoMutedColor
+                    )
+                }
+            }
+        }
+        item {
+            val ttsSurface = readerPanelSurfaceColor(
+                base = MaterialTheme.colorScheme.surfaceVariant,
+                emphasis = 0.86f,
+                minAlpha = READER_TOOLBAR_MIN_OPACITY
+            )
+            val ttsContentColor = readerPanelContentColor(ttsSurface)
+            val ttsMutedColor = readerPanelMutedContentColor(ttsSurface)
+            ReaderBlurredPanelContainer(
+                shape = RoundedCornerShape(20.dp),
+                surfaceColor = ttsSurface,
+                blurAmount = uiState.toolbarBlur
+            ) {
+                Column(
+                    modifier = Modifier.padding(16.dp),
+                    verticalArrangement = Arrangement.spacedBy(8.dp)
+                ) {
+                    Text(
+                        text = readerText.servicesTtsTitle,
+                        style = MaterialTheme.typography.titleSmall,
+                        fontWeight = FontWeight.SemiBold,
+                        color = ttsContentColor
+                    )
+                    Text(
+                        text = if (isTextReader) readerText.servicesTtsBody else readerText.servicesTtsUnavailableBody,
+                        style = MaterialTheme.typography.bodyMedium,
+                        color = ttsMutedColor
+                    )
+                    if (isTextReader) {
+                        Text(
+                            text = "${readerText.ttsVoiceTitle}: " +
+                                readerTtsVoiceLabel(
+                                    selectedVoiceName = uiState.ttsVoiceName,
+                                    voices = ttsState.availableVoices,
+                                    language = strings.languageCode,
