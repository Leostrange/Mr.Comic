+private fun readerTtsChunkLabel(
+    currentChunkIndex: Int,
+    totalChunks: Int,
+    language: String
+): String {
+    if (totalChunks <= 0) {
+        return when (language) {
+            "ja" -> "テキストなし"
+            "zh" -> "没有文本"
+            "ko" -> "텍스트 없음"
+            "ru" -> "Нет текста"
+            else -> "No text"
+        }
+    }
+    val current = currentChunkIndex.coerceIn(0, totalChunks - 1) + 1
+    return when (language) {
+        "ja" -> "チャンク $current / $totalChunks"
+        "zh" -> "片段 $current / $totalChunks"
+        "ko" -> "청크 $current / $totalChunks"
+        "ru" -> "Фрагмент $current / $totalChunks"
+        else -> "Chunk $current / $totalChunks"
+    }
+}
