+private data class ReaderMilestoneRecapText(
+    val chapterLabel: String,
+    val titleLabel: String,
+    val keepReading: String,
+    val progress: (Int, Int) -> String,
+    val completed: String,
+    val pagesDelta: (Int) -> String,
+    val xpAwarded: (Int) -> String,
+    val today: (Int, Int) -> String,
+    val week: (Int, Int) -> String,
+    val streak: (Int) -> String
+)
+
+@Composable
+fun ReaderMilestoneRecapCard(
+    recap: ReaderProgressRecap,
+    secondaryLabel: String?,
+    modifier: Modifier = Modifier,
+    showMascot: Boolean = true,
+    onPrimaryAction: () -> Unit,
+    onSecondaryAction: (() -> Unit)?,
+    onDismiss: () -> Unit
+) {
+    val strings = LocalStrings.current
+    val recapText = remember(strings.languageCode) { readerMilestoneRecapText(strings.languageCode) }
+    val isTitleCompleted = recap.type == ReaderProgressRecapType.TITLE_COMPLETE
+    val progressFraction = if (recap.totalPages > 0) {
+        ((recap.currentPage + 1).toFloat() / recap.totalPages.toFloat()).coerceIn(0f, 1f)
+    } else {
+        0f
+    }
+    val cardSurface = readerPanelSurfaceColor(
+        base = MaterialTheme.colorScheme.surface,
+        emphasis = 0.82f,
+        minAlpha = READER_TOOLBAR_MIN_OPACITY
+    )
+    val cardContentColor = readerPanelContentColor(cardSurface)
+    val cardMutedContentColor = readerPanelMutedContentColor(cardSurface)
+    ReaderBlurredPanelContainer(
+        modifier = modifier,
+        surfaceColor = cardSurface,
+        blurAmount = READER_TOOLBAR_DEFAULT_BLUR,
+        shape = RoundedCornerShape(26.dp)
+    ) {
+        Column(
+            modifier = Modifier.padding(horizontal = 16.dp, vertical = 14.dp),
+            verticalArrangement = Arrangement.spacedBy(10.dp)
+        ) {
+            Row(
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.spacedBy(10.dp)
+            ) {
+                MrComicMiniAvatar(
+                    showMascot = showMascot,
+                    modifier = Modifier.size(30.dp),
+                    compact = true,
+                    neutralIcon = Icons.AutoMirrored.Filled.MenuBook,
+                    neutralTint = MaterialTheme.colorScheme.primary
+                )
+                Column(
+                    modifier = Modifier.weight(1f),
+                    verticalArrangement = Arrangement.spacedBy(2.dp)
+                ) {
+                    Text(
+                        text = if (isTitleCompleted) recapText.titleLabel else recapText.chapterLabel,
+                        color = MaterialTheme.colorScheme.primary,
+                        style = MaterialTheme.typography.labelLarge
+                    )
+                    Text(
+                        text = recap.chapterTitle ?: recap.comicTitle,
+                        color = cardContentColor,
+                        style = MaterialTheme.typography.bodyMedium.copy(
+                            fontWeight = FontWeight.Medium,
+                            lineHeight = 18.sp
+                        ),
+                        maxLines = 2,
+                        overflow = TextOverflow.Ellipsis
+                    )
+                }
+                IconButton(onClick = onDismiss) {
+                    Icon(Icons.Default.Close, contentDescription = strings.cancel)
+                }
+            }
+
+            if (recap.totalPages > 0) {
+                LinearProgressIndicator(
+                    progress = { progressFraction },
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .clip(RoundedCornerShape(999.dp)),
+                    color = MaterialTheme.colorScheme.primary,
+                    trackColor = MaterialTheme.colorScheme.primary.copy(alpha = 0.14f)
+                )
+                Text(
+                    text = if (isTitleCompleted) {
+                        recapText.completed
+                    } else {
+                        recapText.progress(recap.currentPage + 1, recap.totalPages)
+                    },
+                    color = cardMutedContentColor,
+                    style = MaterialTheme.typography.bodySmall
+                )
+            }
+
+            Row(
+                modifier = Modifier.horizontalScroll(rememberScrollState()),
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+                verticalAlignment = Alignment.CenterVertically
+            ) {
+                if (recap.pagesDelta > 0) {
+                    ReaderMilestoneStatPill(
+                        label = recapText.pagesDelta(recap.pagesDelta)
+                    )
+                }
+                if (recap.xpAwarded > 0) {
+                    ReaderMilestoneStatPill(
+                        label = recapText.xpAwarded(recap.xpAwarded)
+                    )
+                }
+                if (recap.goalEnabled) {
+                    ReaderMilestoneStatPill(
+                        label = recapText.today(recap.pagesReadToday, recap.targetPages)
+                    )
+                    ReaderMilestoneStatPill(
+                        label = recapText.week(recap.pagesReadThisWeek, recap.weeklyTargetPages)
+                    )
+                }
+                if (recap.streakEnabled && recap.currentStreak > 0) {
+                    ReaderMilestoneStatPill(
+                        label = recapText.streak(recap.currentStreak)
+                    )
+                }
+            }
+
+            Row(
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+                verticalAlignment = Alignment.CenterVertically
+            ) {
+                FilledTonalButton(onClick = onPrimaryAction) {
+                    Text(if (isTitleCompleted) strings.back else recapText.keepReading)
+                }
+                if (secondaryLabel != null && onSecondaryAction != null) {
+                    OutlinedButton(onClick = onSecondaryAction) {
+                        Text(secondaryLabel)
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun ReaderMilestoneStatPill(
+    label: String
+) {
+    val pillSurface = readerPanelSurfaceColor(
+        base = MaterialTheme.colorScheme.surfaceVariant,
+        emphasis = 0.72f,
+        minAlpha = READER_TOOLBAR_MIN_OPACITY
+    )
+    ReaderBlurredPanelContainer(
+        surfaceColor = pillSurface,
+        blurAmount = READER_TOOLBAR_DEFAULT_BLUR,
+        shape = RoundedCornerShape(999.dp)
+    ) {
+        Text(
+            text = label,
+            style = MaterialTheme.typography.labelMedium,
+            color = readerPanelContentColor(pillSurface),
+            modifier = Modifier.padding(horizontal = 10.dp, vertical = 6.dp)
+        )
+    }
+}
+
+private fun readerMilestoneRecapText(language: String): ReaderMilestoneRecapText = when (language) {
+    "en" -> ReaderMilestoneRecapText(
+        chapterLabel = "Chapter checkpoint",
+        titleLabel = "Title completed",
+        keepReading = "Keep reading",
