+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+private fun ReaderReadingTabContent(
+    modifier: Modifier,
+    uiState: ReaderUiState,
+    isTextReader: Boolean,
+    onReadingModeChange: (ReadingMode) -> Unit,
+    onBrightnessChange: (Float) -> Unit,
