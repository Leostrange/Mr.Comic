-private fun formatFileSize(bytes: Long): String = when {
-    bytes < 1_024 -> "$bytes B"
-    bytes < 1_048_576 -> "%.1f KB".format(bytes / 1_024.0)
-    bytes < 1_073_741_824L -> "%.1f MB".format(bytes / 1_048_576.0)
-    else -> "%.2f GB".format(bytes / 1_073_741_824.0)
-}
