+            lines += currentLine
+        }
+        if (lines.size == maxLines && words.joinToString(" ").length > lines.joinToString(" ").length) {
+            lines[lines.lastIndex] = lines.last().trimEnd('.', '…') + "…"
+        }
+
+        lines.forEachIndexed { index, line ->
+            canvas.drawText(line, x, startY + index * lineHeight, paint)
+        }
+    }
