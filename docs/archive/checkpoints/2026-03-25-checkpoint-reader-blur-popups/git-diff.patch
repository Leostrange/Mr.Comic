+
+private fun isDarkReaderBackground(backgroundHex: String): Boolean = runCatching {
+    ColorUtils.calculateLuminance(android.graphics.Color.parseColor(backgroundHex)) < 0.5
+}.getOrDefault(false)
+
+private fun readerForegroundHex(backgroundHex: String): String =
+    runCatching {
+        val backgroundColor = android.graphics.Color.parseColor(backgroundHex)
+        val lightCandidate = android.graphics.Color.parseColor("#f6f2ea")
+        val darkCandidate = android.graphics.Color.parseColor("#171717")
+        val lightContrast = ColorUtils.calculateContrast(lightCandidate, backgroundColor)
+        val darkContrast = ColorUtils.calculateContrast(darkCandidate, backgroundColor)
+        if (lightContrast >= darkContrast) "#f6f2ea" else "#171717"
+    }.getOrDefault(if (isDarkReaderBackground(backgroundHex)) "#f6f2ea" else "#171717")
+
+private fun colorSchemePalette(scheme: String): Pair<String, String> {
+    val background = readerBackgroundHex(scheme)
+    return background to readerForegroundHex(background)
 }
 
