+            FlowRow(
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+                verticalArrangement = Arrangement.spacedBy(8.dp)
+            ) {
+                FilledTonalButton(onClick = { mrComicQuickActionHandler(primaryAction, onOpenFiles, onOpenBookmarks, onOpenQuotes)() }) {
