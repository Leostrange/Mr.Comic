+private fun rememberReaderClockText(): String {
+    val formatter = remember {
+        SimpleDateFormat("HH:mm", Locale.getDefault())
+    }
+    return produceState(initialValue = formatter.format(Date())) {
+        while (true) {
+            value = formatter.format(Date())
+            delay(30_000)
+        }
+    }.value
+}
+
+private fun readerInfoSlotValue(
+    slot: String,
+    uiState: ReaderUiState,
+    clockText: String,
+    language: String
+): String? {
+    val normalizedSlot = ReaderInfoSlot.fromStored(slot)
+    val currentPage = (uiState.currentPage + 1).coerceAtLeast(1)
+    val progressPercent = if (uiState.totalPages <= 0) {
+        0
+    } else {
+        ((currentPage.toFloat() / uiState.totalPages.toFloat()) * 100f).toInt().coerceIn(0, 100)
+    }
+    return when (normalizedSlot) {
+        ReaderInfoSlot.NONE -> null
+        ReaderInfoSlot.BOOK_TITLE -> uiState.comic?.title?.takeIf { it.isNotBlank() }
+        ReaderInfoSlot.CHAPTER_TITLE -> currentReaderChapterTitle(
+            tableOfContents = uiState.tableOfContents,
+            currentPage = uiState.currentPage
+        )
+        ReaderInfoSlot.TIME -> clockText
+        ReaderInfoSlot.PROGRESS -> "$progressPercent%"
+        ReaderInfoSlot.PAGE -> if (uiState.totalPages > 0) {
+            "$currentPage / ${uiState.totalPages}"
+        } else {
+            if (language == "en") "Page $currentPage" else "Стр. $currentPage"
+        }
+    }
+}
