+private fun scrollToFragmentJs(fragment: String): String {
+    val escapedFragment = JSONObject.quote(fragment)
+    return """(function(){
+      var frag=$escapedFragment;
+      if(!frag)return;
+      var target=document.getElementById(frag);
+      if(!target){
+        var named=document.getElementsByName(frag);
+        if(named&&named.length>0)target=named[0];
+      }
+      if(target&&target.scrollIntoView){
+        target.scrollIntoView({block:'start',behavior:'auto'});
+      } else {
+        window.location.hash=frag;
+      }
+    })();"""
+}
