+                        onClick = { onTextAlignChange(id) },
+                        label = { Text(label, style = MaterialTheme.typography.bodySmall) }
+                    )
+                }
+            }
+        }
+        item { HorizontalDivider() }
+        item {
+            OutlinedButton(
+                onClick = onReset,
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .padding(top = 4.dp)
+            ) {
+                Text(readerText.resetDefaults)
+            }
+        }
+    }
+}
