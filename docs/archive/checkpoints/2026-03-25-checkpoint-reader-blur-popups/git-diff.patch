+private fun formatQuoteDate(timestamp: Long, language: String): String {
+    val pattern = when (language) {
+        "en" -> "MMM d"
+        "ja", "zh", "ko" -> "yyyy-MM-dd"
+        else -> "dd.MM.yyyy"
+    }
+    return SimpleDateFormat(pattern, Locale.getDefault()).format(Date(timestamp))
+}
