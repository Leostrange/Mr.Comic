<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SAF — без READ_EXTERNAL_STORAGE для API 33+, доступ через content:// uri -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:targetApi="33" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="com.example.mrcomic.ComicApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_1"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_1"
        android:supportsRtl="true"
        android:theme="@style/Theme.MrComic">

        <!-- ML Kit: declare bundled OCR models for offline Japanese / Chinese / Korean + Latin -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr_ja,ocr_zh,ocr_ko" />

        <!-- Внутренний modern splash больше не используется как launcher entry point -->
        <activity
            android:name=".splash.ModernSplashActivity"
            android:exported="false"
            android:theme="@style/Theme.App.Starting" />

        <!-- Video splash fullscreen: теперь это прямой launcher target -->
        <activity
            android:name=".splash.VideoSplashActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- ═══════════════════════════════════════════════════════
             MAIN ACTIVITY — обработка "Open with" intent-фильтров
             PDF / CBZ / CBR / ZIP / EPUB / text document formats
             ═══════════════════════════════════════════════════════ -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MrComic"
            tools:targetApi="31"
            tools:ignore="AppLinkUrlError">

            <!-- PDF -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:pathPattern=".*\\.pdf" />
                <data android:scheme="file" android:pathPattern=".*\\.PDF" />
            </intent-filter>

            <!-- CBZ -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-cbz" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.comicbook+zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:pathPattern=".*\\.cbz" />
                <data android:scheme="file" android:pathPattern=".*\\.CBZ" />
            </intent-filter>

            <!-- CBR -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-cbr" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.comicbook-rar" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-rar-compressed" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:pathPattern=".*\\.cbr" />
                <data android:scheme="file" android:pathPattern=".*\\.CBR" />
                <data android:scheme="file" android:pathPattern=".*\\.rar" />
                <data android:scheme="file" android:pathPattern=".*\\.RAR" />
            </intent-filter>

            <!-- ZIP -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:pathPattern=".*\\.zip" />
                <data android:scheme="file" android:pathPattern=".*\\.ZIP" />
            </intent-filter>

            <!-- EPUB -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:pathPattern=".*\\.epub" />
                <data android:scheme="file" android:pathPattern=".*\\.EPUB" />
            </intent-filter>

            <!-- MOBI / AZW -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-mobipocket-ebook" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.amazon.ebook" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:pathPattern=".*\\.mobi" />
                <data android:scheme="file" android:pathPattern=".*\\.MOBI" />
                <data android:scheme="file" android:pathPattern=".*\\.azw" />
                <data android:scheme="file" android:pathPattern=".*\\.AZW" />
                <data android:scheme="file" android:pathPattern=".*\\.azw3" />
                <data android:scheme="file" android:pathPattern=".*\\.AZW3" />
            </intent-filter>

            <!-- FB2 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-fictionbook+xml" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:pathPattern=".*\\.fb2" />
                <data android:scheme="file" android:pathPattern=".*\\.FB2" />
                <data android:scheme="file" android:pathPattern=".*\\.fb2\\.zip" />
                <data android:scheme="file" android:pathPattern=".*\\.FB2\\.ZIP" />
            </intent-filter>

            <!-- Plain text / HTML -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/html" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:pathPattern=".*\\.txt" />
                <data android:scheme="file" android:pathPattern=".*\\.TXT" />
                <data android:scheme="file" android:pathPattern=".*\\.html" />
                <data android:scheme="file" android:pathPattern=".*\\.HTML" />
                <data android:scheme="file" android:pathPattern=".*\\.htm" />
                <data android:scheme="file" android:pathPattern=".*\\.HTM" />
            </intent-filter>

            <!-- DOC / DOCX / RTF / ODT -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/msword" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/rtf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/rtf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:pathPattern=".*\\.doc" />
                <data android:scheme="file" android:pathPattern=".*\\.DOC" />
                <data android:scheme="file" android:pathPattern=".*\\.docx" />
                <data android:scheme="file" android:pathPattern=".*\\.DOCX" />
                <data android:scheme="file" android:pathPattern=".*\\.rtf" />
                <data android:scheme="file" android:pathPattern=".*\\.RTF" />
                <data android:scheme="file" android:pathPattern=".*\\.odt" />
                <data android:scheme="file" android:pathPattern=".*\\.ODT" />
            </intent-filter>

            <!-- DjVu -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/vnd.djvu" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/x-djvu" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:pathPattern=".*\\.djvu" />
                <data android:scheme="file" android:pathPattern=".*\\.DJVU" />
                <data android:scheme="file" android:pathPattern=".*\\.djv" />
                <data android:scheme="file" android:pathPattern=".*\\.DJV" />
            </intent-filter>

            <!-- content:// universal (от файлового менеджера) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="*/*" />
            </intent-filter>

            <!-- Share/Open from external apps like Telegram -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/vnd.djvu" />
                <data android:mimeType="image/x-djvu" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/vnd.djvu" />
                <data android:mimeType="image/x-djvu" />
            </intent-filter>
        </activity>

        <!-- ═══════════════════════════════════════════════════════
             АЛЬТЕРНАТИВНЫЕ ИКОНКИ ПРИЛОЖЕНИЯ
             Все disabled по умолчанию — включаются через AppIconManager
             targetActivity = VideoSplashActivity (без промежуточного системного окна)
             ═══════════════════════════════════════════════════════ -->
        <activity-alias
            android:name=".MainActivityIcon_1"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_1"
            android:roundIcon="@mipmap/ic_launcher_1"
            android:label="@string/app_name"
            android:targetActivity=".splash.VideoSplashActivity">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityIcon_2"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_2"
            android:roundIcon="@mipmap/ic_launcher_2"
            android:label="@string/app_name"
            android:targetActivity=".splash.VideoSplashActivity">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityIcon_3"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_3"
            android:roundIcon="@mipmap/ic_launcher_3"
            android:label="@string/app_name"
            android:targetActivity=".splash.VideoSplashActivity">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityIcon_4"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_4"
            android:roundIcon="@mipmap/ic_launcher_4"
            android:label="@string/app_name"
            android:targetActivity=".splash.VideoSplashActivity">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityIcon_5"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_5"
            android:roundIcon="@mipmap/ic_launcher_5"
            android:label="@string/app_name"
            android:targetActivity=".splash.VideoSplashActivity">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityIcon_6"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_6"
            android:roundIcon="@mipmap/ic_launcher_6"
            android:label="@string/app_name"
            android:targetActivity=".splash.VideoSplashActivity">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityIcon_7"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_7"
            android:roundIcon="@mipmap/ic_launcher_7"
            android:label="@string/app_name"
            android:targetActivity=".splash.VideoSplashActivity">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- ═══════════════════════════════════════════════════════
             AUDIOBOOK PLAYBACK SERVICE (Media3 / ExoPlayer)
             Runs as a foreground service when audio is playing.
             ═══════════════════════════════════════════════════════ -->
        <service
            android:name=".media.AudiobookPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <service
            android:name="com.example.feature.reader.ui.ReaderTtsPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />

    </application>

</manifest>
